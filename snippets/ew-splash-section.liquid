{{ 'ew-splash-screen.css' | asset_url | stylesheet_tag }}

<div id="ew-splash-intro">
  {% capture splash_content %}
    <div class="ew-splash-content">
      {% if settings.video_url != blank %}
        <div class="ew-splash-video">
          {{  if settings.video_url | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: 1920 }}
        </div>
      {% elsif settings.splash_image != blank %}
        <picture>
          {% if settings.splash_image_mob != blank %}
            <source media="(max-width: 600px)" srcset="{{ settings.splash_image_mob | image_url: width: 1920 }}">
          {% endif %}
          <img 
            class="ew-img-fluid"
            src="{{ settings.splash_image | image_url: width: 1280 }}" 
            loading="lazy" 
            srcset="
              {{ settings.splash_image | image_url: width: 620 }} 620w,
              {{ settings.splash_image | image_url: width: 800 }} 800w,
              {{ settings.splash_image | image_url: width: 1100 }} 1100w,
              {{ settings.splash_image | image_url: width: 1280 }} 1280w"
            sizes="(max-width: 600px) 600px, 100vw"
            alt="{{ settings.heading | escape }}">
        </picture>
      {% endif %}

      <div class="ew-splash-content-inner">
        <h3>{{ settings.heading }}</h3>
        <div class="ew-btn ew-text-center">
          {% if settings.button_link != blank %}
            <a class="ew-btn-primary" href="{{ settings.button_link }}">{{ settings.button_text }}</a>
          {% endif %}
        </div>
      </div>
    </div>
  {% endcapture %}

  {% render 'ew-text-lang',
    arabic_text: splash_content,
    english_text: splash_content
  %}
</div>
