{{ 'ew-hero-section.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="ew-hero-section ew-hero-section-{{ section.id }}" id="ew-hero-section">
  <div class="ew-hero-row">
    <div class="ew-hero-wrap">
      <div class="ew-hero-video-block">
        {% if s.video != blank %}
          <div class="mobile-hide">
            {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: 1920 }}
          </div>
          {% if s.mobile_video != blank %}
            <div class="desktop-hide">
              {{ s.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, width: 1920 }}
            </div>
          {% endif %}
        {% else  %}
          <picture>
            <source media="(max-width: 600px)" srcset="{{ s.mobile_image | image_url: width: 600 }}">
            <img 
              class="ew-img-fluid"
              src="{{ s.image | image_url: width: 1280 }}" 
              loading="lazy" 
              srcset="
                {{ s.image | image_url: width: 620 }} 620w,
                {{ s.image | image_url: width: 800 }} 800w,
                {{ s.image | image_url: width: 1100 }} 1100w,
                {{ s.image | image_url: width: 1280 }} 1280w"
              sizes="(max-width: 600px) 600px, 100vw"
              alt="{{ s.heading }}">
          </picture>
      {% endif %}
        
      </div>
      <div class="ew-hero-text-row">
        <div class="page-width">
          <div class="ew-hero-text-block ew-hero-text-block-{{ s.content_alignment }}">
            {% if s.heading != blank %}
              <h3>{{ s.heading }}</h3>
            {% endif %}
            {% if s.button_link != blank %}
              <div class="ew-btn ew-text-center">
                <a class="ew-btn-primary" href="{{ s.button_link }}">{{ s.button_text }}</a>
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "<> Banner Text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Presence is Captivating"
    },
    {
      "type": "header",
      "content": "Content Alignment"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "video",
      "id": "video",
      "label": "A Shopify-hosted desktop video"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "A Shopify-hosted mobile video"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Discover"
    }
  ],
  "presets": [
    {
      "name": "<> Banner Text"
    }
  ],
}
{% endschema %}