{{ 'ew-richtext.css' | asset_url | stylesheet_tag }}

<section class="ew-richtext-section ew-richtext-section-{{ section.id }}" id="ew-richtext-section">
  <div class="ew-richtext-row">
    <div class="page-width">
      <div class="ew-richtext-wrap">
        {% for block in section.blocks %}
          {% if block.type == 'image_block' %}
            <img 
              class="ew-img-fluid"
              src="{{ block.settings.image | image_url: width: 1920 }}" 
              loading="lazy" 
              srcset="
                {{ block.settings.image | image_url: width: 620 }} 620w,
                {{ block.settings.image | image_url: width: 800 }} 800w,
                {{ block.settings.image | image_url: width: 1100 }} 1100w,
                {{ block.settings.image | image_url: width: 1280 }} 1280w"
              sizes="(max-width: 600px) 600px, 100vw"
              alt="Acoon Image {{ forloop.index }}">
          {% endif %}

          {% if block.type == 'text_block' %}
            {{ block.settings.description }}
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema  %}
{
  "name":"<> Richtext",
  "settings":[],
  "blocks":[
    {
      "type":"image_block",
      "name":"Image Block",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type":"text_block",
      "name":"Text Block",
      "settings": [
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets":[
    {
      "name":"<> Richtext"
    }
  ]
}
{% endschema  %}