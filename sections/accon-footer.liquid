{% comment %}
  <footer class="accon-footer" id="accon-footer">
    <div class="accon-footer-row">
      <div class="page-width">
        <div class="accon-footer-col">
          {%- for block in section.blocks -%}
            <div class="accon-footer-content flex justify-content-between">
              <div class="accon-footer-links flex">
                {%- case block.type -%}
                  {%- when 'link_list' -%}
                    {%- if block.settings.menu != blank -%}
                      <div class="accon-footer-links-col">
                        <h3>{{ block.settings.heading }}</h3>
                        <ul class="accon-footer-links-list flex">
                          {%- for link in block.settings.menu.links -%}
                            <li class="accon-footer-links-list-item">
                              <a href="{{ link.url }}">{{ link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      </div>
                    {%- endif -%}
                  {%- when 'footer_shop' -%}
                    <div class="accon-footer-shop">
                      <h6 class="accon-footer-shop-heading">test</h6>
                      <div class="accon-footer-shop-logo flex">
                        {%- if block.settings.shop_img != blank -%}
                          <img src="{{ block.settings.shop_img | img_url: 'master' }}" alt="Shop Logo">
                        {%- endif -%}
                      </div>
                    </div>
                {%- endcase -%}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="accon-footer-bottom flex justify-content-between">
          <div class="accon-footer-bottom-left flex">
            <div class="accon-footer-bottom-col">
              <p class="accon-footer-bottom-copyright">&copy; 2020 Accon. All rights reserved.</p>
            </div>
            <div class="accon-footer-bottom-col">
              <ul class="accon-footer-bottom-list flex">
                <li class="accon-footer-bottom-list-item"><a href="#">Privacy Policy</a></li>
                <li class="accon-footer-bottom-list-item"><a href="#">Terms & Conditions</a></li>
              </ul>
            </div>
          </div>

          <div class="accon-footer-bottom-right">
            <img src="https://cdn.shopify.com/s/files/1/0602/8545/2422/files/Frame_1000007344.png?v=1741634555" alt="">
          </div>

          {%- if section.settings.payment_enable -%}
            <div class="footer__payment">
              <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
              <ul class="list list-payment" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- if section.settings.logo != blank -%}
          <div class="accon-footer-logo">
            <img src="{{ section.settings.logo | img_url: 'master' }}" alt="Footer Logo">
          </div>
        {%- endif -%}
      </div>
    </div>
  </footer>
{% endcomment %}

