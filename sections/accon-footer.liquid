{{ 'ew-newsletter.css' | asset_url | stylesheet_tag }}

<footer class="accon-footer" id="accon-footer">
  <div class="accon-footer-row">
    <div class="page-width">
  
      <div class="ew-newsletter">
        
        <div class="ew-newsletter-form">
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ew-form-field">
              <label class="ew-form-label" for="NewsletterForm--{{ section.id }}">Be The First to Know</label>
              <div class="ew-form-fields-wrap">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="Newsletter-error--{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="Newsletter-success--{{ section.id }}"
                {% endif %}
                placeholder="Enter your e-mail"
                required
              >
                <button
                  type="submit"
                  aria-label="{{ 'newsletter.button_label' | t }}"
                >
                  <span class="svg-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M8.10001 4.43662C8.18037 4.35636 8.28929 4.31128 8.40286 4.31128C8.51644 4.31128 8.62536 4.35636 8.70572 4.43662L12.54 8.27033L8.70572 12.1035C8.62448 12.1792 8.51702 12.2204 8.40599 12.2184C8.29497 12.2165 8.18903 12.1715 8.11051 12.093C8.03199 12.0145 7.98701 11.9085 7.98505 11.7975C7.98309 11.6865 8.0243 11.579 8.10001 11.4978L11.3274 8.27033L8.10001 5.0429C8.01975 4.96254 7.97467 4.85362 7.97467 4.74005C7.97467 4.62647 8.01975 4.51697 8.10001 4.43662Z" fill="white"/>
                      <path fill-rule="evenodd" clip-rule="evenodd" d="M4 7.85718H11.4286V8.71432H4V7.85718Z" fill="white"/>
                    </svg>
                  </span>
                  <span class="accon-newsletter-btn"> Subscribe </span>
                </button>
            </div>
            </div>
          {% endform %}
        </div>
        
        <div class="ew-newsletter-localization">
          <localization-form>
            {%- form 'localization' -%}
              <div>
                <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>

          <localization-form>
            {%- form 'localization' -%}
              <div>
                <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
              </div>
            {%- endform -%}
          </localization-form>
        </div>

      </div>

      <div class="accon-footer-row">
        <div class="accon-footer-col">
          <div class="accon-footer-content">
            <div class="accon-footer-links">
              {% for block in section.blocks %}
                {% if block.type == 'link_list' %}
                  <div class="accon-footer-links-col">
                    <h3>{{ block.settings.heading }}</h3>
                    <ul class="accon-footer-links-list">
                      {%- for link in block.settings.menu.links -%}
                        <li class="accon-footer-links-list-item">
                          <a href="{{ link.url }}">{{ link.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="accon-footer-shop">
              <h6 class="accon-footer-shop-heading">{{ section.settings.shop_ttl }}</h6>
              <div class="accon-footer-shop-logo">
                {% for block in section.blocks %}
                  {% if block.type == 'footer_shop' %}
                    <img class="ew-img-fluid" src="{{ block.settings.shop_img | image_url: width: 500 }}" alt="">
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>

          <div class="accon-footer-bottom">
            <div class="accon-footer-bottom-left ">
              <div class="accon-footer-bottom-col">
                <span class="accon-footer-bottom-copyright">
                  {% render 'ew-text-lang',
                    arabic_text: section.settings.ar_copyright_txt.
                    english_text: section.settings.copyright_txt
                  %}
                </span>
              </div>
            </div>

            <div class="accon-footer-bottom-right">
              <img class="ew-img-fluid" src="https://cdn.shopify.com/s/files/1/0602/8545/2422/files/Frame_1000007344.png?v=1741634555" alt="">
            </div>

            {%- if section.settings.payment_enable -%}
              <div class="footer__payment">
                <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
                <ul class="list list-payment" role="list">
                  {%- for type in shop.enabled_payment_types -%}
                    <li class="list-payment__item">
                      {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                    </li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.logo != blank -%}
            <div class="accon-footer-logo">
              <img src="{{ section.settings.logo | img_url: 'master' }}" alt="Footer Logo" class="ew-img-fluid">
            </div>
          {%- endif -%}
        </div>
      </div>

    </div>
  </div>
</footer>

{% schema %}
{
  "name": "<> Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "shop_ttl",
      "label": "Logo Title",
      "default":"Shop Acoon at"
    },
    {
      "type": "richtext",
      "id": "copyright_txt",
      "label": "Copyright Text",
      "default": "<p>Acoon by Beige The Label © 2024 – All Rights Reserved </p>"
    },
    {
      "type":"header",
      "content": "AR CONTENT"
    },
    {
      "type": "richtext",
      "id": "ar_copyright_txt",
      "label": "Copyright Text",
      "default": "<p>Acoon by Beige The Label © 2024 – All Rights Reserved </p>"
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "limit": 3,
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
        "type": "footer_shop",
      "name": "Footer Shop",
      "limit": 3,
      "settings": [
       {
         "type": "image_picker",
          "id": "shop_img",
          "label": "Shop Images",
       },
      ]
    }
  ],
  "presets": [
    {
      "name": "<> Footer"
    }
  ]
}
{% endschema %}
