{{ 'ew-collection-slider.css' | asset_url | stylesheet_tag }}
{{ 'ew-product-card.css' | asset_url | stylesheet_tag }}
{% assign s = section.settings %}
<section class="ew-collection-slider-section ew-collection-slider-section-{{ section.id }}" id="ew-collection-slider">
  <div class="ew-collection-row">
    <div class="page-width">
      <div class="ew-collection-wrap">
        <h3 class="ew-title">
          {% render 'ew-text-lang', 
            arabic_text: s.ar_collection.title,
            english_text: s.collection.title
          %}
        </h3>
        <div class="ew-collection-slider">
          <div class="splide" data-name="Collection Slider">
            <div class="splide__track">
              <div class="splide__list">

                {% capture arabic_products %}
                  {% for product in s.ar_collection.products %}
                    <div class="splide__slide">
                      {% render 'ew-product-card', card_product: product %}
                    </div>
                  {% endfor %}
                {% endcapture %}

                {% capture english_products %}
                  {% for product in s.collection.products %}
                    <div class="splide__slide">
                      {% render 'ew-product-card', card_product: product %}
                    </div>
                  {% endfor %}
                {% endcapture %}

                {% render 'ew-text-lang',
                  arabic_text: arabic_products,
                  english_text: english_products
                %}

              </div>
            </div>
          </div>
        </div>

        <div class="ew-btn ew-text-center">
          {% capture arabic_button %}
            <a class="ew-btn-secondary" href="{% if s.ar_button_link != blank %}{{ s.ar_button_link }}{% else %}{{ s.ar_collection.url }}{% endif %}">{{ s.ar_button_text }}</a>
          {% endcapture %}

          {% capture english_button %}
            <a class="ew-btn-secondary" href="{% if s.button_link != blank %}{{ s.button_link }}{% else %}{{ s.collection.url }}{% endif %}">{{ s.button_text }}</a>
          {% endcapture %}

          {% render 'ew-text-lang',
            arabic_text: arabic_button,
            english_text: english_button
          %}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "<> Collection Slider",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "ENG Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop The Drop"
    },
    {
      "type": "header",
      "content": "AR Collection"
    },
    {
      "type": "collection",
      "id": "ar_collection",
      "label": "Collection"
    },
    {
      "type": "url",
      "id": "ar_button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "ar_button_text",
      "label": "Button Text",
      "default": "Shop The Drop"
    }
  ],
  "presets": [
    {
      "name": "<> Collection Slider"
    }
  ]
}
{% endschema %}
