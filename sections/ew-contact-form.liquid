{{ 'ew-contact-form.css' | asset_url | stylesheet_tag }}

{% assign s = section.settings %}

{% if request.locale.iso_code contains 'ar' %}
  {% assign name = "الاسم" %}
  {% assign email = "البريد الإلكتروني" %}
  {% assign phone = "رقم الهاتف" %}
  {% assign message = "رسالة" %}
  {% assign submit = "إرسال" %}
{% else %}
  {% assign name = "Name" %}
  {% assign email = "Email Address" %}
  {% assign phone = "Phone Number" %}
  {% assign message = "Message" %}
  {% assign submit = "Submit" %}
{% endif %}

<section class="ew-contact-form ew-contact-form-{{ section.id }}" id="ew-contact-form">
  <div class="ew-contact-form-row">
    <div class="page-width">
      <div class="ew-contact-form-wrap">
        <div class="ew-contact-form-inner">

          <h6>
            {% render 'ew-text-lang', english_text: s.subheading, arabic_text: s.ar_subheading %}
          </h6>
          <h3>
            {% render 'ew-text-lang', english_text: s.heading, arabic_text: s.ar_heading %}
          </h3>
          <p>
            {% render 'ew-text-lang', english_text: s.description, arabic_text: s.ar_description %}
          </p>

          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {{ 'icon-success.svg' | inline_asset_content }}
                {{ 'templates.contact.form.post_success' | t }}
              </h2>
            {%- elsif form.errors -%}
              <div class="form__message">
                <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                  {{ 'icon-error.svg' | inline_asset_content }}
                  {{ 'templates.contact.form.error_heading' | t }}
                </h2>
              </div>
              <ul class="form-status-list caption-large" role="list">
                {%- if form.errors.translated_fields.email -%}
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <div class="ew-contact-form-fields">
              <div class="ew-contact-form-field">
                <label for="ContactForm-name" class="visually-hidden">{{ name }}</label>
                <input 
                  type="text"
                  id="ContactForm-name"
                  name="contact[{{ name }}]"
                  placeholder="{{ name }}"
                  autocomplete="name"
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-email" class="visually-hidden">{{ email }}</label>
                <input 
                  type="email"
                  id="ContactForm-email"
                  name="contact[{{ email }}]"
                  placeholder="{{ email }}"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-phone" class="visually-hidden">{{ phone }}</label>
                <input 
                  type="tel"
                  id="ContactForm-phone"
                  name="contact[{{ phone }}]"
                  placeholder="{{ phone }}"
                  autocomplete="tel"
                  required
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-comment" class="visually-hidden">{{ message }}</label>
                <textarea 
                  id="ContactForm-comment"
                  name="contact[{{ message }}]"
                  placeholder="{{ message }}"
                  autocomplete="off"
                  required
                ></textarea>
              </div>
            </div>

            <div class="ew-contact__button">
              <button type="submit">{{ submit }}</button>
            </div>
          {%- endform -%}
          
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Contact Form",
  "settings": [
    {
      "type": "header",
      "content": "ENG CONTENT"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in Touch"
    },
    {
      "type": "text",
      "id": "description",
      "label": "Description",
      "default": "Please tell us more about your inquiry using the form below and click to submit your information."
    },
    {
      "type": "header",
      "content": "AR CONTENT"
    },
    {
      "type": "text",
      "id": "ar_subheading",
      "label": "Subheading",
      "default": "اتصل"
    },
    {
      "type": "text",
      "id": "ar_heading",
      "label": "Heading",
      "default": "ابقى على تواصل"
    },
    {
      "type": "text",
      "id": "ar_description",
      "label": "Description",
      "default": "يرجى إخبارنا بمزيد من التفاصيل حول استفسارك باستخدام النموذج أدناه ثم الضغط للإرسال."
    }
  ],
  "presets": [
    {
      "name": "<> Contact Form"
    }
  ]
}
{% endschema %}
