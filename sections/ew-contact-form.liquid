{{ 'ew-contact-form.css' | asset_url | stylesheet_tag }}

<section class="ew-contact-form ew-contact-form-{{ section.id }}" id="ew-contact-form">
  <div class="ew-contact-form-row">
    <div class="page-width">
      <div class="ew-contact-form-wrap">

        <div class="ew-contact-form-inner">
          <h6>Contact</h6>
          <h3>Get in Touch</h3>
          <p>Please tell us more about your inquiry using the form below and click to submit your information.</p>

          {%- form 'contact' -%}
            {%- if form.posted_successfully? -%}
              <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>
                {{ 'icon-success.svg' | inline_asset_content }}
                {{ 'templates.contact.form.post_success' | t }}
              </h2>
            {%- elsif form.errors -%}
              <div class="form__message">
                <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>
                  {{ 'icon-error.svg' | inline_asset_content }}
                  {{ 'templates.contact.form.error_heading' | t }}
                </h2>
              </div>
              <ul class="form-status-list caption-large" role="list">
                {%- if form.errors.translated_fields.email -%}
                  <li>
                    <a href="#ContactForm-email" class="link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                {%- endif -%}
              </ul>
            {%- endif -%}

            <div class="ew-contact-form-fields">

              <div class="ew-contact-form-field">
                <label for="ContactForm-name" class="visually-hidden">Name</label>
                <input 
                  type="text"
                  id="ContactForm-name"
                  name="contact[Name]"
                  placeholder="Name"
                  autocomplete="name"
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-email" class="visually-hidden">Email Address</label>
                <input 
                  type="email"
                  id="ContactForm-email"
                  name="contact[Email Address]"
                  placeholder="Email Address"
                  autocomplete="email"
                  required
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-phone" class="visually-hidden">Phone Number</label>
                <input 
                  type="tel"
                  id="ContactForm-phone"
                  name="contact[Phone number]"
                  placeholder="Phone number"
                  autocomplete="tel"
                  required
                />
              </div>

              <div class="ew-contact-form-field">
                <label for="ContactForm-comment" class="visually-hidden">Message</label>
                <textarea 
                  id="ContactForm-comment"
                  name="contact[Comment]"
                  placeholder="Message"
                  autocomplete="off"
                  required
                ></textarea>
              </div>
            </div>

            <div class="ew-contact__button">
              <button type="submit" class="">
                Submit
              </button>
            </div>
          {%- endform -%}
          
        </div>
        
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "<> Contact Form",
  "settings": [],
  "presets": [
    {
      "name": "<> Contact Form"
    }
  ]
}
{% endschema %}